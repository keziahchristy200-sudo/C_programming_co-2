#include <stdio.h>

int main()
{
    int price, qty, senior;
    int total, net;
    double gross, discount, tax, correct_total, correct_net;

    printf("Enter medicine price: ");
    scanf("%d", &price);

    printf("Enter quantity: ");
    scanf("%d", &qty);

    printf("Senior citizen? (1-Yes, 0-No): ");
    scanf("%d", &senior);

    /* Original calculation */
    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = total > 1000 ? total - 50 : total;

    printf("\n--- Original Calculation ---\n");
    printf("Total = %d\n", total);
    printf("Net = %d\n", net);

    /* Correct calculation */
    gross = price * qty;

    discount = senior ? gross * 0.15 : 0;

    tax = gross * 0.05;

    correct_total = gross - discount + tax;

    correct_net = correct_total > 1000
                  ? correct_total - 50 : correct_total;

    printf("\n--- Correct Calculation ---\n");
    printf("Gross = %.2f\n", gross);
    printf("Discount = %.2f\n", discount);
    printf("GST = %.2f\n", tax);
    printf("Total = %.2f\n", correct_total);
    printf("Net = %.2f\n", correct_net);

    return 0;
}
