#include <stdio.h>

int calls = 0;

int verify_card(int disability)
{
    calls++;
    return disability;
}

int main()
{
    int senior, eligible, disability;
    int i;
    int concession;

    int senior_count = 0;
    int eligible_count = 0;
    int disability_count = 0;

    printf("--- Short Circuit Evaluation ---\n");

    for (i = 1; i <= 1000; i++)
    {
        senior = (i % 2 == 0);
        eligible = (i % 3 == 0);
        disability = (i % 10 == 0);

        if (senior)
            senior_count++;

        if (eligible)
            eligible_count++;

        if (disability)
            disability_count++;
    }

    /* Method 1 */
    calls = 0;

    for (i = 1; i <= 1000; i++)
    {
        senior = (i % 2 == 0);
        eligible = (i % 3 == 0);
        disability = (i % 10 == 0);

        concession =
            (senior && eligible) ||
            verify_card(disability);
    }

    printf("\nMethod 1 Calls = %d\n", calls);

    /* Method 2 */
    calls = 0;

    for (i = 1; i <= 1000; i++)
    {
        senior = (i % 2 == 0);
        eligible = (i % 3 == 0);
        disability = (i % 10 == 0);

        concession =
            verify_card(disability) ||
            (senior && eligible);
    }

    printf("Method 2 Calls = %d\n", calls);

    /* AND operator comparison */
    calls = 0;

    senior = 0;
    eligible = verify_card(1);

    printf("\nUsing & : Calls = %d\n", calls);

    calls = 0;

    senior = 0;
    eligible = senior && verify_card(1);

    printf("Using && : Calls = %d\n", calls);

    return 0;
}
