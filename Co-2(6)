#include <stdio.h>

int main()
{
    double balance = 10000;
    double rate = 2;
    double repayment = 2000;

    double interest;
    double total_interest = 0;
    double actual_payment;

    int month = 0;
    int limit = 360;

    printf("Month\tInterest\tPayment\t\tBalance\n");

    if (balance <= 0 || rate < 0 || repayment <= 0)
    {
        printf("Invalid loan details.\n");
        return 0;
    }

    if (repayment <= balance * rate / 100)
    {
        printf("Loan cannot be repaid with this amount.\n");
        return 0;
    }

    while (balance > 0.01)
    {
        if (month >= limit)
        {
            printf("Maximum month limit reached.\n");
            break;
        }

        month++;

        interest = balance * rate / 100;

        total_interest += interest;

        balance += interest;

        if (repayment >= balance)
            actual_payment = balance;
        else
            actual_payment = repayment;

        balance -= actual_payment;

        if (balance < 0.01)
            balance = 0;

        printf("%d\t%.2f\t\t%.2f\t\t%.2f\n",
               month, interest, actual_payment, balance);
    }

    if (balance == 0)
    {
        printf("\nLoan fully repaid!\n");
    }

    printf("Total Months = %d\n", month);
    printf("Total Interest = Rs. %.2f\n", total_interest);
    printf("Remaining Balance = Rs. %.2f\n", balance);

    return 0;
}
