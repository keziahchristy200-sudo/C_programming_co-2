#include <stdio.h>

unsigned long checks = 0;

/* Original for loop */
int prime_original(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    for (unsigned long i = 2; i < n; i++)
    {
        checks++;

        if (n % i == 0)
            return 0;
    }

    return 1;
}

/* Improved for loop */
int prime_for(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    for (unsigned long i = 2; i * i <= n; i++)
    {
        checks++;

        if (n % i == 0)
            return 0;
    }

    return 1;
}

/* Improved while loop */
int prime_while(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    while (i * i <= n)
    {
        checks++;

        if (n % i == 0)
            return 0;

        i++;
    }

    return 1;
}

/* Improved do-while loop */
int prime_do(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    do
    {
        if (i * i > n)
            break;

        checks++;

        if (n % i == 0)
            return 0;

        i++;

    } while (1);

    return 1;
}

int main()
{
    unsigned long tickets[] = {97, 100, 7919, 1000003};

    for (int i = 0; i < 4; i++)
    {
        unsigned long n = tickets[i];

        int result = prime_for(n);

        printf("%8lu %-9s divisions = %lu\n",
               n,
               result ? "prime" : "not prime",
               checks);
    }

    printf("\n--- While Loop ---\n");

    prime_while(97);
    printf("97 divisions = %lu\n", checks);

    printf("\n--- Do While Loop ---\n");

    prime_do(97);
    printf("97 divisions = %lu\n", checks);

    printf("\n--- Original Loop ---\n");

    prime_original(97);
    printf("97 divisions = %lu\n", checks);

    return 0;
}
